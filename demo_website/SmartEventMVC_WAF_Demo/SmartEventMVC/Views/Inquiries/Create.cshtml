@{
    ViewData["Title"] = "Send Inquiry";
    var eventId = ViewBag.EventId;
    var eventTitle = ViewBag.EventTitle as string ?? "Event";
    var prefillName = ViewBag.PrefillName as string ?? "";
    var prefillMobile = ViewBag.PrefillMobile as string ?? "";
    var isLoggedIn = !string.IsNullOrEmpty(prefillMobile);
}

<div class="inquiry-container">
    <div class="inquiry-header text-center mb-5">
        <h1 class="gradient-text display-5 fw-bold mb-3">
            <i class="fas fa-question-circle me-3"></i>Send Inquiry
        </h1>
        <p class="lead text-light opacity-90 mb-2">
            About: <strong class="text-teal">@eventTitle</strong>
        </p>
    </div>

    <div class="glass-panel modern-card p-4 p-md-5">
        <form asp-action="Create" method="post" class="inquiry-form">
            <input type="hidden" name="EventId" value="@eventId" />

            <div class="row g-4">
                <!-- Name -->
                <div class="col-md-6">
                    <div class="form-floating mb-3">
                        <input type="text" class="form-control modern-input" id="Name" name="Name"
                               value="@prefillName" placeholder="Your full name" required />
                        <label for="Name">
                            <i class="fas fa-user me-2"></i>Your Name
                        </label>
                    </div>
                </div>

                <!-- Mobile -->
                <div class="col-md-6">
                    <div class="form-floating mb-3">
                        <input type="text" class="form-control modern-input" id="Mobile" name="Mobile"
                               value="@prefillMobile" placeholder="07xxxxxxxx" required />
                        <label for="Mobile">
                            <i class="fas fa-mobile-alt me-2"></i>Mobile Number
                        </label>
                    </div>
                    @if (isLoggedIn)
                    {
                        <small class="form-hint d-block mt-1">
                            We'll use this to contact you about your inquiry
                        </small>
                    }
                </div>
            </div>

            <!-- Message -->
            <div class="mb-5">
                <div class="form-floating">
                    <textarea class="form-control modern-textarea text-white" id="Message" name="Message"
                              placeholder="Please provide details about your inquiry..." rows="6" required></textarea>
                    <label for="Message">
                        <i class="fas fa-comment-dots me-2"></i>Your Message
                    </label>
                </div>
                <small class="form-hint d-block mt-2">
                    Be as specific as possible so we can assist you better
                </small>
            </div>

            <!-- Action Buttons -->
            <div class="form-actions d-flex flex-wrap gap-3 mt-5">
                <button type="submit" class="btn modern-btn primary flex-grow-1">
                    <i class="fas fa-paper-plane me-2"></i>Send Inquiry
                </button>

                @if (eventId != null)
                {
                    <a asp-controller="Events" asp-action="Details" asp-route-id="@eventId"
                       class="btn modern-btn outline flex-grow-1">
                        <i class="fas fa-arrow-left me-2"></i>Back to Event
                    </a>
                }
                else
                {
                    <a asp-controller="Home" asp-action="Index"
                       class="btn modern-btn outline flex-grow-1">
                        <i class="fas fa-home me-2"></i>Back to Home
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<style>
    .inquiry-container {
        max-width: 900px;
        margin: 2rem auto;
        padding: 0 1.5rem;
    }

    .inquiry-header h1 {
        font-size: 2.8rem;
        margin-bottom: 0.5rem;
    }

    .gradient-text {
        background: var(--gradient-primary);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .glass-panel {
        background: rgba(15, 23, 42, 0.65);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(165, 180, 252, 0.18);
        border-radius: 20px;
        box-shadow: 0 15px 40px -10px rgba(0,0,0,0.5);
    }

    /* FIX: prevent Bootstrap grey background on focus */
    .modern-input:focus,
    .modern-textarea:focus,
    .form-control:focus {
        background-color: rgba(30, 41, 59, 0.85) !important;
        color: #ffffff !important;
        border-color: #a855f7 !important;
        box-shadow: 0 0 0 4px rgba(168,85,247,0.15) !important;
    }

    /* Also fix autofill color (Chrome) */
    .modern-input:-webkit-autofill,
    .modern-input:-webkit-autofill:focus,
    .modern-textarea:-webkit-autofill {
        -webkit-box-shadow: 0 0 0 1000px rgba(30, 41, 59, 0.85) inset !important;
        -webkit-text-fill-color: #ffffff !important;
    }


    /* Floating labels – improved visibility */
    .form-floating > label {
        color: #cbd5e1 !important; /* default = light gray */
        padding-left: 1rem;
        transition: all 0.3s ease;
    }

    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-control:not(:placeholder-shown) ~ label {
        color: #a855f7 !important; /* violet when active/focused */
        transform: scale(0.85) translateY(-1.5rem) translateX(0.75rem);
        font-weight: 500;
        opacity: 1 !important;
    }

    .modern-input,
    .modern-textarea {
        background-color: rgba(30,41,59,0.65) !important;
        color: #ffffff !important;
        border: 1px solid rgba(165,180,252,0.3);
    }


        .modern-input:focus,
        .modern-textarea:focus {
            border-color: #a855f7;
            box-shadow: 0 0 0 4px rgba(168,85,247,0.15);
            background: rgba(30,41,59,0.75);
        }

    .modern-textarea {
        height: auto;
        min-height: 140px;
        padding-top: 1.75rem;
    }

        /* Placeholder - light color */
        .modern-input::placeholder,
        .modern-textarea::placeholder {
            color: #cbd5e1 !important;
            opacity: 0.75;
        }

    /* Light helper text */
    .form-hint,
    small.form-hint,
    .form-floating > small {
        color: #e2e8f0 !important;
        font-size: 0.875rem;
        opacity: 0.9;
    }

    /* Buttons */
    .modern-btn {
        padding: 0.75rem 1.75rem;
        border-radius: 12px;
        font-weight: 500;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

        .modern-btn.primary {
            background: var(--gradient-primary);
            border: none;
            color: white;
            box-shadow: 0 6px 20px rgba(91,33,182,0.3);
        }

            .modern-btn.primary:hover {
                transform: translateY(-3px);
                box-shadow: 0 12px 30px rgba(91,33,182,0.45);
                filter: brightness(1.08);
            }

        .modern-btn.outline {
            background: transparent;
            border: 1px solid rgba(165,180,252,0.4);
            color: #e2e8f0;
        }

            .modern-btn.outline:hover {
                background: rgba(165,180,252,0.12);
                border-color: #a855f7;
                color: white;
                transform: translateY(-2px);
            }

    @@media (max-width: 768px) {
        .form-actions {
            flex-direction: column;
        }

        .modern-btn {
            width: 100%;
        }
    }
</style>